{
  "entities": {
    "user": {
      "title": "User",
      "description": "Public user profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["customer", "admin"], "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "userPrivate": {
      "title": "UserPrivate",
      "description": "Private user information including addresses and wishlist",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "wishlist": { "type": "array", "description": "Array of product IDs in wishlist" },
        "cart": { "type": "array", "description": "Array of cart items" },
        "addresses": { "type": "array", "description": "Array of saved addresses" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    },
    "product": {
      "title": "Product",
      "description": "E-commerce product catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "brand": { "type": "string", "maxLength": 50 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discountPercent": { "type": "number" },
        "image": { "type": "string", "maxLength": 500 },
        "images": { "type": "array", "description": "Cloudinary CDN image URLs" },
        "sizes": { "type": "array", "description": "Available product sizes" },
        "colors": { "type": "array", "description": "Available color variants" },
        "description": { "type": "string", "maxLength": 2000 },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "inStock": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isTrending": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "price", "image", "inStock"]
    },
    "order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerPhone": { "type": "string", "maxLength": 20 },
        "customerEmail": { "type": "string", "format": "email", "maxLength": 128 },
        "itemTotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "discount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cod", "upi", "card"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "completed", "failed"] },
        "orderStatus": { "type": "string", "enum": ["placed", "confirmed", "packing", "shipped", "out_for_delivery", "delivered", "cancelled"] },
        "otp": { "type": "string", "maxLength": 10 },
        "appliedCoupon": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "customerName", "customerPhone", "itemTotal", "totalAmount", "paymentMethod", "orderStatus"]
    },
    "review": {
      "title": "Review",
      "description": "Customer review and rating for a product",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "verifiedPurchase": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "userId", "userName", "rating", "comment"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/user" },
      "description": "Public profile of a registered user"
    },
    "/users/{userId}/private/data": {
      "schema": { "$ref": "#/entities/userPrivate" },
      "description": "Private address and wishlist data strictly restricted to user"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/product" },
      "description": "Public catalog products readable by all, writable by admins"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/order" },
      "description": "Orders readable and creatable by the ordering customer and admin"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/review" },
      "description": "Product reviews readable by all, creatable by authenticated users"
    }
  }
}
